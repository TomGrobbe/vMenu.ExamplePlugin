<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      The vMenu repository checked out next to this one, so the plugin can be built against
      a vMenu you built yourself before that version is on nuget.org. Harmless when the
      folder does not exist: NuGet simply finds nothing there and falls back to nuget.org.
      Delete this line if you only ever want released packages.
    -->
    <add key="vmenu-local" value="..\vMenu\vMenu\build\packages" />
  </packageSources>
</configuration>
