<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Both halves of the vMenu plugin API. Their version always matches the vMenu Enhanced
      release they belong to, so pin these to the vMenu version your server actually runs and
      raise them when you update vMenu. Pinned rather than floating: a plugin that silently
      follows the newest package is a plugin that breaks on a vMenu release nobody tested it
      against, and during an alpha that is not a distant worry.
    -->
    <PackageVersion Include="vMenu.Enhanced.ClientAPI" Version="0.0.1-alpha.94" />
    <PackageVersion Include="vMenu.Enhanced.ServerAPI" Version="0.0.1-alpha.94" />
  </ItemGroup>
</Project>
